FROM node:24.18.0-trixie-slim

WORKDIR /app

# Keep psql available for local database diagnostics and maintenance.
RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
RUN npm ci

COPY . .

EXPOSE 5000

CMD ["npm", "run", "dev"]
